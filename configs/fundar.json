{
  "domain": "fundar",
  "cuda_visible_devices": "0",
  "common": {
    "root_path": "./dataset/ProductAmt/",
    "model_id": "ProductAmt_{seq_len}_{pred_len}",
    "model": "iTransformer_TSLFL",
    "features": "M",
    "seq_len": 30,
    "label_len": 0,
    "pred_len": 1,
    "e_layers": 2,
    "d_layers": 1,
    "d_model": 512,
    "d_ff": 512,
    "factor": 3,
    "enc_in": 88,
    "dec_in": 88,
    "c_out": 88,
    "des": "Exp",
    "itr": 1,
    "out_patch_len": 8,
    "TSLFL_patch_len": 8,
    "seed": 1,
    "num_workers": 4,
    "batch_size": 1,
    "checkpoints": "./checkpoints/"
  },
  "stages": {
    "plfm": {"task_name": "preModel", "is_training": 1, "data_path": "ProductAmt.csv", "data": "custom", "model": "PLFM", "mask": 0.8, "patience": 10, "train_epochs": 20},
    "residual": {"task_name": "TSLFL_Forcast", "is_training": 1, "data_path": "ProductAmt.csv", "data": "custom", "patience": 10, "train_epochs": 20, "learning_rate": 0.001},
    "sft": {"task_name": "Financial_train_data", "is_training": 0, "data_path": "ProductAmt_with_info.csv", "data": "financial_llm_train"},
    "infer": {"task_name": "LLM", "is_training": 0, "data_path": "ProductAmt_with_info.csv", "data": "financial_info"}
  },
  "llm": {"base_model": "Qwen/Qwen3-8B", "adapter_path": "./adapters/fundar/h{pred_len}"},
  "qlora": {"train_file": "./outputs/fundar/h{pred_len}/llm_train_data.json", "rank": 16, "alpha": 32, "dropout": 0.05, "epochs": 3, "learning_rate": 0.0002, "batch_size": 1, "gradient_accumulation_steps": 8, "max_length": 8192, "load_in_4bit": true}
}
